{
  "name": "code-recorder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File launch.ps1",
    "mcp": "node mcp.mjs",
